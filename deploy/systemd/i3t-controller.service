[Unit]
Description=ice3tier controller
Documentation=https://github.com/fuqiuluo/ice3tier
After=network-online.target
Wants=network-online.target

[Service]
# 对外地址等写在 /etc/i3t/controller.env 里，比如：
#   I3T_CONTROLLER_ARGS=--data-dir /var/lib/i3t-controller --public-addr ctl.example.com:20331
# 别的选项见 i3t-controller --help。
EnvironmentFile=/etc/i3t/controller.env
ExecStart=/usr/local/bin/i3t-controller $I3T_CONTROLLER_ARGS
User=i3t-controller
Group=i3t-controller
StateDirectory=i3t-controller
StateDirectoryMode=0700
Restart=always
RestartSec=2
LimitNOFILE=1048576

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
